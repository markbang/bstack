{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "bstack desktop shell built with Electron",
  "author": "bstack",
  "repository": "https://github.com/markbang/bstack",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux",
    "preview": "electron-vite preview",
    "lint": "biome check .",
    "check-types": "bun check -p tsconfig.node.json --no-script && bun check -p tsconfig.web.json --no-script"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/uno-config": "workspace:*",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.4",
    "@types/node": "^26.6.11",
    "@unocss/vite": "^66.13.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "solid-js": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
