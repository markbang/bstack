{
  "name": "fullstack-template",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "build": "bun run --filter='*' build",
    "lint": "bun run --filter='*' lint",
    "typecheck": "bun run --filter='*' check-types",
    "check-types": "bun run --filter='*' check-types",
    "test": "bun run --filter='*' test",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && bun run knip && bun run test && bun run build",
    "commitlint": "commitlint --edit",
    "knip": "knip",
    "prepare": "prek install || true",
    "dev:web": "bun run --filter=web dev",
    "dev:docs": "bun run --filter=docs dev",
    "dev:desktop": "bun run --filter=desktop dev",
    "dev:api": "bun run --filter=api dev",
    "db:generate": "bun run --filter=api db:generate",
    "db:migrate": "bun run --filter=api db:migrate",
    "db:studio": "bun run --filter=api db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@j178/prek": "^0.5.12",
    "knip": "^6.48.0"
  }
}
